<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>LimitsMustBePositive</fullName>
    <active>true</active>
    <description>Limits, when set, must be greater than zero.</description>
    <errorConditionFormula
  >OR(AND(NOT(ISBLANK(MaxConcurrentConversations__c)), MaxConcurrentConversations__c &lt;= 0), AND(NOT(ISBLANK(MaxConversationsPer24Hours__c)), MaxConversationsPer24Hours__c &lt;= 0), AND(NOT(ISBLANK(MaxTokensPer24Hours__c)), MaxTokensPer24Hours__c &lt;= 0))</errorConditionFormula>
    <errorDisplayField>MaxTokensPer24Hours__c</errorDisplayField>
    <errorMessage
  >Limits, when set, must be greater than zero. Leave a limit blank for no limit.</errorMessage>
</ValidationRule>
