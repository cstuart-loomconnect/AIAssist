<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>FlowAPINameRequired</fullName>
    <active>true</active>
    <description
  >Flow API Name is required when Action Type is Flow or Screen Flow.</description>
    <errorConditionFormula
  >AND(OR(ISPICKVAL(ActionType__c, &quot;Flow&quot;), ISPICKVAL(ActionType__c, &quot;Screen Flow&quot;)), ISBLANK(FlowAPIName__c))</errorConditionFormula>
    <errorDisplayField>FlowAPIName__c</errorDisplayField>
    <errorMessage
  >Flow API Name is required when Action Type is Flow or Screen Flow.</errorMessage>
</ValidationRule>
