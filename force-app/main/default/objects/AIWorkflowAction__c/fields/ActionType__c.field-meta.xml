<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>ActionType__c</fullName>
    <description
  >Determines which mechanism is used to execute this action.</description>
    <inlineHelpText
  >Choose whether this action runs an Apex class, an autolaunched Flow, or a Screen Flow. A Screen Flow is shown in a window over the chat and runs as the user.</inlineHelpText>
    <label>Action Type</label>
    <required>true</required>
    <trackHistory>true</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>Apex</fullName>
                <default>false</default>
                <label>Apex</label>
            </value>
            <value>
                <fullName>Flow</fullName>
                <default>false</default>
                <label>Flow</label>
            </value>
            <value>
                <fullName>Screen Flow</fullName>
                <default>false</default>
                <label>Screen Flow</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
