<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>ActiveRequiresInstructions</fullName>
    <active>true</active>
    <description>An active skill must have instructions.</description>
    <errorConditionFormula>AND(IsActive__c, ISBLANK(Instructions__c))</errorConditionFormula>
    <errorDisplayField>Instructions__c</errorDisplayField>
    <errorMessage>Add instructions before activating the skill.</errorMessage>
</ValidationRule>
