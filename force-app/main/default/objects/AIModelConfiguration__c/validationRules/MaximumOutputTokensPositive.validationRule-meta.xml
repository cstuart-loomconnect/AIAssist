<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>MaximumOutputTokensPositive</fullName>
    <active>true</active>
    <description>Maximum Output Tokens must be 1 or more.</description>
    <errorConditionFormula
  >AND(NOT(ISBLANK(MaximumOutputTokens__c)), MaximumOutputTokens__c &lt; 1)</errorConditionFormula>
    <errorDisplayField>MaximumOutputTokens__c</errorDisplayField>
    <errorMessage>Maximum Output Tokens must be 1 or more.</errorMessage>
</ValidationRule>
