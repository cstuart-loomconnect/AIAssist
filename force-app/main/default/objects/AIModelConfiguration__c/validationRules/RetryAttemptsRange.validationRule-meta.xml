<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>RetryAttemptsRange</fullName>
    <active>true</active>
    <description>Retry Attempts must be between 0 and 5.</description>
    <errorConditionFormula
  >AND(NOT(ISBLANK(RetryAttempts__c)), OR(RetryAttempts__c &lt; 0, RetryAttempts__c &gt; 5))</errorConditionFormula>
    <errorDisplayField>RetryAttempts__c</errorDisplayField>
    <errorMessage>Retry Attempts must be between 0 and 5.</errorMessage>
</ValidationRule>
