<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>CostsMustBeZeroOrMore</fullName>
    <active>true</active>
    <description>Token prices cannot be negative.</description>
    <errorConditionFormula
  >OR(InputCostPerMillionTokens__c &lt; 0, OutputCostPerMillionTokens__c &lt; 0)</errorConditionFormula>
    <errorMessage>Token prices cannot be negative.</errorMessage>
</ValidationRule>
