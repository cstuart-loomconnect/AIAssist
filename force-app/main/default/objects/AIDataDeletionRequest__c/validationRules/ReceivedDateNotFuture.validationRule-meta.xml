<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>ReceivedDateNotFuture</fullName>
    <active>true</active>
    <description>Received Date cannot be in the future.</description>
    <errorConditionFormula
  >AND(NOT(ISBLANK(ReceivedDate__c)), ReceivedDate__c &gt; TODAY())</errorConditionFormula>
    <errorDisplayField>ReceivedDate__c</errorDisplayField>
    <errorMessage>Received Date cannot be in the future.</errorMessage>
</ValidationRule>
