<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>MaxRowsRange</fullName>
    <active>true</active>
    <description>Max Rows must be between 1 and 200.</description>
    <errorConditionFormula
  >AND(NOT(ISBLANK(MaxRows__c)), OR(MaxRows__c &lt; 1, MaxRows__c &gt; 200))</errorConditionFormula>
    <errorDisplayField>MaxRows__c</errorDisplayField>
    <errorMessage>Max Rows must be between 1 and 200.</errorMessage>
</ValidationRule>
