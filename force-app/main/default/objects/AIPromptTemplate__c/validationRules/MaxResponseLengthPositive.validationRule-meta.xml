<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>MaxResponseLengthPositive</fullName>
    <active>true</active>
    <description>Max Response Length must be 1 or more.</description>
    <errorConditionFormula
  >AND(NOT(ISBLANK(MaxResponseLength__c)), MaxResponseLength__c &lt; 1)</errorConditionFormula>
    <errorDisplayField>MaxResponseLength__c</errorDisplayField>
    <errorMessage>Max Response Length must be 1 or more.</errorMessage>
</ValidationRule>
