<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>AccessMode__c</fullName>
    <description
  >Who may use this agent. Assigned Users Only limits it to the users and permission sets on its Agent Assignments. All AI Assist Users lets anyone with the AI Assist User permission set use it.</description>
    <inlineHelpText
  >Choose Assigned Users Only for any agent that touches sensitive data.</inlineHelpText>
    <label>Access Mode</label>
    <required>false</required>
    <trackHistory>true</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>Assigned Users Only</fullName>
                <default>true</default>
                <label>Assigned Users Only</label>
            </value>
            <value>
                <fullName>All AI Assist Users</fullName>
                <default>false</default>
                <label>All AI Assist Users</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
