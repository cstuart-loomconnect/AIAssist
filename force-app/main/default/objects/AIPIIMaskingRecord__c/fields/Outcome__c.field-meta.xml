<?xml version="1.0" encoding="UTF-8" ?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Outcome__c</fullName>
    <description
  >Whether masking worked. Failed means a value could not be masked, and the request must not have been sent.</description>
    <inlineHelpText>Set by the platform.</inlineHelpText>
    <label>Outcome</label>
    <required>false</required>
    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>Masked</fullName>
                <default>false</default>
                <label>Masked</label>
            </value>
            <value>
                <fullName>Failed</fullName>
                <default>false</default>
                <label>Failed</label>
            </value>
            <value>
                <fullName>Skipped</fullName>
                <default>false</default>
                <label>Skipped</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
